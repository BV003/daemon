# 必填：Anthropic API key
ANTHROPIC_API_KEY=

# 可选：换模型（默认 claude-opus-5-5，想省钱可以用 claude-haiku-5-5）
# DAEMON_MODEL=claude-haiku-5-5

# 可选：限流，每个访客每天几条、全站每天几条
# DAEMON_PER_IP_DAILY=30
# DAEMON_GLOBAL_DAILY=500

# 可选：摘要发到 Telegram，不填就只打印在终端里
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 可选：部署在反向代理后面时打开，用 X-Forwarded-For 识别访客
# TRUST_PROXY=1

# PORT=3000
